CREATE TABLE InitialFormEntity (
ticket_number  TEXT PRIMARY KEY NOT NULL,
structure TEXT NOT NULL
);

insert:
INSERT INTO InitialFormEntity (ticket_number,structure)
VALUES (?, ?);


deleteAll:
DELETE FROM InitialFormEntity;

selectAll:
SELECT * FROM InitialFormEntity;

selectByTicketNumber:
SELECT * FROM InitialFormEntity WHERE ticket_number = :ticket_number;


updateStructure:
UPDATE  InitialFormEntity
SET structure = :structure
WHERE ticket_number = :ticket_number;