CREATE TABLE PhotoEntity (
pk INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
task_id INTEGER NOT NULL ,
component_key TEXT NOT NULL,
index_row INTEGER NOT NULL,
origin_uri TEXT NOT NULL,
edited_uri TEXT NOT NULL,
angle TEXT NOT NULL
);

insert:
INSERT OR REPLACE INTO PhotoEntity (task_id,component_key,index_row,origin_uri,edited_uri,angle)
VALUES (?,?,?,?,?,?);


deletePhoto:
DELETE FROM  PhotoEntity WHERE origin_uri=:origin_uri;


deleteByComponentKey:
DELETE FROM PhotoEntity WHERE task_id = :task_id ;


selectByComponentKey:
SELECT * FROM PhotoEntity WHERE task_id=:task_id;


updateAngle:
UPDATE  PhotoEntity
SET angle = :angle
WHERE origin_uri = :origin_uri ;

updateEditUri:
UPDATE PhotoEntity
SET edited_uri=:edited_uri
WHERE origin_uri=:origin_uri;



