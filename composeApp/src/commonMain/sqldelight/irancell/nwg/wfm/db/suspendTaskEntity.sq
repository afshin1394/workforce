CREATE TABLE SuspendTaskEntity (
ticket_number  TEXT PRIMARY KEY NOT NULL,
reason TEXT NOT NULL,
description TEXT NOT NULL,
attachmentsUri TEXT NOT NULL,
isSent INTEGER NOT NULL,
datetime  TEXT  NOT NULL ,
latitude TEXT NOT NULL,
longitude TEXT NOT NULL
);


insert:
INSERT INTO SuspendTaskEntity (ticket_number,reason,description,attachmentsUri,isSent,datetime,latitude,longitude)
VALUES (?, ?,?,?,?,?,?,?);



updateUnsend:
UPDATE SuspendTaskEntity
SET isSent = 1;

updateAttachements:
UPDATE  SuspendTaskEntity
SET attachmentsUri = :attachements
WHERE ticket_number = :ticket_number;

updateSuspendDetails:
UPDATE  SuspendTaskEntity
SET datetime = :dateTime , latitude = :latitude , longitude= :longitude
WHERE ticket_number = :ticket_number;


deleteAllSent:
DELETE FROM SuspendTaskEntity WHERE isSent = 1;

deleteByTicketNumber:
DELETE FROM SuspendTaskEntity WHERE ticket_number = :ticket_number;

removeSentItems:
DELETE FROM SuspendTaskEntity WHERE isSent = 1;




selectAllNotSent:
SELECT * FROM SuspendTaskEntity WHERE isSent = 0 ORDER BY datetime ASC;

selectAll:
SELECT * FROM SuspendTaskEntity ORDER BY datetime ASC ;

selectByTaskId:
SELECT * FROM SuspendTaskEntity WHERE ticket_number = :ticket_number;

