CREATE  TABLE TaskEntity (
ticket_number TEXT NOT NULL,
ticket_state TEXT NOT NULL,
level INTEGER NOT NULL,
location TEXT NOT NULL,
site  TEXT  NOT NULL,
region  TEXT  NOT NULL,
province  TEXT  NOT NULL,
city  TEXT  NOT NULL
);


insert:
INSERT INTO TaskEntity (ticket_number,ticket_state,level,location,site,region,province,city)
VALUES (?, ?,?,?,?,?,?,?);


deleteAll:
DELETE FROM TaskEntity;


selectAll:
SELECT * FROM TaskEntity;

updateStatus:
UPDATE  TaskEntity
SET ticket_state = :ticket_state
WHERE ticket_number = :ticket_number;