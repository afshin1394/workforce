
CREATE TABLE GeneralLocation(
 latitude TEXT NOT NULL,
 longitude TEXT NOT NULL,
 datetime TEXT NOT NULL,
 isSent INTEGER
);

insert:
INSERT INTO GeneralLocation (longitude,latitude,datetime,isSent)
VALUES (?, ?,?,?);



update:
UPDATE GeneralLocation
SET isSent = 1;



removeSentLocations:
DELETE FROM GeneralLocation WHERE isSent = 1;


selectAllNotSentLocation:
SELECT * FROM GeneralLocation WHERE isSent = 0;


selectAll:
SELECT * FROM GeneralLocation;

deleteAllSent:
DELETE FROM GeneralLocation WHERE isSent = 1;